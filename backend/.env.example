NODE_ENV=production
# Vercel Cron sends this secret in Authorization: Bearer <secret>.
CRON_SECRET=replace-with-a-long-random-worker-secret
# Optional override if the ML provider exposes a different liveness route.
AI_LIVENESS_PATH=/ai/v1/liveness
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
GEMINI_API_KEY=replace-with-gemini-api-key
ALGOD_SERVER_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
# Optional only when your Indexer provider requires an API key; never expose this to the browser.
ALGORAND_INDEXER_API_TOKEN=
ALGORAND_PORT=443
NEUROCLASS_TREASURY_ADDRESS=HYNRAYO4IGZRBJ6MWZTBIRAOVWQFZODFDQBSJNQNFSP3TRGV5IYOOAZN5A
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_TEST_PRICE_USDC_MICRO=100000
X402_ASSIGNMENT_PRICE_USDC_MICRO=50000
X402_PROJECT_IDEA_PRICE_USDC_MICRO=150000
# x402 settlement is facilitator-backed and does not require a treasury mnemonic.
# If a separate refund worker is added, keep its fresh signer only in a secret manager.
# Google Workspace SMTP. Use a dedicated mailbox and a 16-character app password.
# Store real values only in the backend deployment's secure environment settings.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_USER=attendance@example.com
GOOGLE_SMTP_APP_PASSWORD=replace-with-google-workspace-app-password
GOOGLE_SMTP_FROM=attendance@example.com
