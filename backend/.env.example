# Vercel (main API). Every value here is SERVER-ONLY. Never copy these into
# Cloudflare Pages (frontend) variables.
NODE_ENV=production

# ---------------------------------------------------------------- Core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Comma-separated list of allowed browser origins (your Cloudflare Pages domains).
ALLOWED_ORIGINS=https://neuroclass.pages.dev,https://www.your-domain.com
GEMINI_API_KEY=replace-with-gemini-api-key
# Vercel Cron sends this secret in Authorization: Bearer <secret>.
CRON_SECRET=replace-with-a-long-random-worker-secret

# ---------------------------------------------------------------- Face recognition (existing Render AI service)
# Used for attendance AND exam identity verification. Server-to-server only.
AI_SERVICE_URL=https://your-face-service.onrender.com
AI_SERVICE_SECRET=replace-with-face-service-secret
# Optional overrides
AI_LIVENESS_PATH=/ai/v1/liveness
# Exam face check route; falls back to /ai/v1/attendance/frame when this returns 404.
AI_EXAM_FACE_PATH=/ai/v1/proctoring/exam-frame
# Minimum similarity (0-100) for an exam identity match.
EXAM_FACE_MATCH_THRESHOLD=45

# ---------------------------------------------------------------- ML proctoring service (ml-service/ on Render)
ML_PROCTORING_URL=https://neuroclass-ml-proctoring.onrender.com
# Must equal ML_SERVICE_API_KEY configured on the Render service.
ML_PROCTORING_API_KEY=replace-with-a-long-random-key

# ---------------------------------------------------------------- Code execution sandbox (Judge0 or Piston)
# Untrusted code is never executed by this API. Point these at an isolated sandbox.
# CODE_RUNNER_PROVIDER: judge0 | piston | disabled
CODE_RUNNER_PROVIDER=disabled
CODE_RUNNER_URL=https://your-judge0-or-piston-host
# Optional auth header for the sandbox, e.g. X-Auth-Token (self-hosted Judge0) or X-RapidAPI-Key.
CODE_RUNNER_AUTH_HEADER=
CODE_RUNNER_AUTH_TOKEN=
# Only for Judge0 via RapidAPI:
CODE_RUNNER_RAPIDAPI_HOST=
# Optional comma-separated subset of: c,cpp,java,python,javascript,typescript,csharp,go,rust,php,ruby,kotlin,swift
CODE_RUNNER_LANGUAGES=
# Durable per-user cap on code runs per hour.
CODE_RUNNER_HOURLY_LIMIT=240

# ---------------------------------------------------------------- Storage
CLASSROOM_MATERIALS_BUCKET=classroom-materials
ASSIGNMENT_FILES_BUCKET=assignment-files

# ---------------------------------------------------------------- Email (Google Workspace SMTP)
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_USER=attendance@example.com
GOOGLE_SMTP_APP_PASSWORD=replace-with-google-workspace-app-password
GOOGLE_SMTP_FROM=attendance@example.com

# ---------------------------------------------------------------- Google Drive classroom materials
GOOGLE_DRIVE_CLIENT_ID=replace-with-google-oauth-web-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-oauth-web-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-backend.example.com/api/google-drive/callback
GOOGLE_DRIVE_FRONTEND_ORIGIN=https://neuroclass.pages.dev
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-or-base64-key
GOOGLE_DRIVE_STATE_SECRET=replace-with-a-long-random-state-secret

# ---------------------------------------------------------------- Payments (TEMPORARILY DISABLED)
# Keep false. When re-enabling, also set VITE_PAYMENTS_ENABLED=true on the frontend
# and move Stripe prices/redirect URLs server-side first (see docs/SECURITY.md).
PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=
# ALGOD_SERVER_URL=https://testnet-api.algonode.cloud
# ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
# NEUROCLASS_TREASURY_ADDRESS=
# X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# X402_TEST_PRICE_USDC_MICRO=100000
# X402_ASSIGNMENT_PRICE_USDC_MICRO=50000
# X402_PROJECT_IDEA_PRICE_USDC_MICRO=150000

# ---------------------------------------------------------------- Removed
# PORTAL_HANDOFF_SECRET and VITE_TEST_PORTAL_URL are no longer used: the
# separate test_creation portal has been merged into this application.
