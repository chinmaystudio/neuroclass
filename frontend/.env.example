# Cloudflare Pages (frontend). Every VITE_* value is PUBLIC: it is embedded in
# the browser bundle. Never put secrets here.

# Vercel API base URL (no trailing slash).
VITE_API_URL=https://your-api.vercel.app

# Supabase project URL and publishable/anon key (public by design; RLS protects data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_publishable_key

# Payments (x402 / Algorand / Stripe test mode) are TEMPORARILY DISABLED.
# Set to true only together with PAYMENTS_ENABLED=true on the backend.
VITE_PAYMENTS_ENABLED=false

# Optional: self-host the on-device MediaPipe face model instead of the public CDN.
# VITE_MEDIAPIPE_WASM_URL=https://your-cdn.example.com/mediapipe/wasm
# VITE_FACE_LANDMARKER_MODEL_URL=https://your-cdn.example.com/models/face_landmarker.task

# Legacy payment settings (only used when payments are re-enabled).
# VITE_ALGOD_SERVER_URL=https://testnet-api.algonode.cloud
# VITE_NEUROCLASS_TREASURY_ADDRESS=
# VITE_X402_NETWORK=
# VITE_X402_USDC_ASSET_ID=
